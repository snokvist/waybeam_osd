+static lv_result_t decoder_get_area(lv_image_decoder_t * decoder, lv_image_decoder_dsc_t * dsc,
+                                    const lv_area_t * full_area, lv_area_t * decoded_area)
+{
+    LV_UNUSED(decoder);
+    LV_UNUSED(full_area);
+
+    lv_libpng_stream_t * stream = dsc->user_data;
+    if(stream == NULL) return LV_RESULT_INVALID;
+
+    if(setjmp(png_jmpbuf(stream->png_ptr))) {
+        return LV_RESULT_INVALID;
+    }
+
+    if(decoded_area->y1 == LV_COORD_MIN) {
+        png_set_read_fn(stream->png_ptr, stream, png_read_cb);
+        if(stream->is_mem) {
+            if(stream->mem_size < 8 || png_sig_cmp(stream->mem, 0, 8)) return LV_RESULT_INVALID;
+            stream->mem_ofs = 8;
+            png_set_sig_bytes(stream->png_ptr, 8);
+        }
+        else {
+            uint8_t sig[8];
+            uint32_t rn = 0;
+            lv_fs_read(&stream->file, sig, sizeof(sig), &rn);
+            if(rn != sizeof(sig) || png_sig_cmp(sig, 0, sizeof(sig))) return LV_RESULT_INVALID;
+            png_set_sig_bytes(stream->png_ptr, 8);
+        }
+
+        png_read_info(stream->png_ptr, stream->info_ptr);
+
+        int passes = png_set_interlace_handling(stream->png_ptr);
+        LV_UNUSED(passes);
+
+        png_set_expand(stream->png_ptr);
+        png_set_strip_16(stream->png_ptr);
+        png_set_gray_to_rgb(stream->png_ptr);
+        if(!(png_get_color_type(stream->png_ptr, stream->info_ptr) & PNG_COLOR_MASK_ALPHA)) {
+            png_set_filler(stream->png_ptr, 0xFF, PNG_FILLER_AFTER);
+        }
+        png_set_bgr(stream->png_ptr);
+        png_read_update_info(stream->png_ptr, stream->info_ptr);
+
+        stream->width = png_get_image_width(stream->png_ptr, stream->info_ptr);
+        stream->height = png_get_image_height(stream->png_ptr, stream->info_ptr);
+        stream->row_bytes = png_get_rowbytes(stream->png_ptr, stream->info_ptr);
+        stream->next_row = 0;
+
+        if(stream->row_buf == NULL) {
+            stream->row_buf = lv_malloc(stream->row_bytes * STREAM_ROWS);
+            if(stream->row_buf == NULL) return LV_RESULT_INVALID;
+        }
+
+        if(stream->draw_buf == NULL) {
+            stream->draw_buf = lv_malloc_zeroed(sizeof(lv_draw_buf_t));
+            if(stream->draw_buf == NULL) return LV_RESULT_INVALID;
+        }
+
+        dsc->header.cf = LV_COLOR_FORMAT_ARGB8888;
+        dsc->header.w = (int32_t)stream->width;
+        dsc->header.h = (int32_t)stream->height;
+        dsc->header.stride = stream->row_bytes;
+    }
+
+    if(stream->next_row >= stream->height) {
+        png_read_end(stream->png_ptr, stream->info_ptr);
+        return LV_RESULT_INVALID;
+    }
+
+    uint32_t rows = STREAM_ROWS;
+    if(stream->next_row + rows > stream->height) rows = stream->height - stream->next_row;
+
+    for(uint32_t row = 0; row < rows; row++) {
+        png_read_row(stream->png_ptr, stream->row_buf + stream->row_bytes * row, NULL);
+    }
+
+    decoded_area->x1 = 0;
+    decoded_area->x2 = (int32_t)stream->width - 1;
+    decoded_area->y1 = (int32_t)stream->next_row;
+    decoded_area->y2 = (int32_t)(stream->next_row + rows - 1);
+
+    stream->next_row += rows;
+
+    stream->draw_buf->data = stream->row_buf;
+    stream->draw_buf->header = dsc->header;
+    stream->draw_buf->header.h = lv_area_get_height(decoded_area);
+    stream->draw_buf->data_size = stream->row_bytes * rows;
+    dsc->decoded = stream->draw_buf;
+
+    return LV_RESULT_OK;
 }
 
