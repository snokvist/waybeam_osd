+static void png_read_cb(png_structp png_ptr, png_bytep data, png_size_t length)
+{
+    lv_libpng_stream_t * stream = png_get_io_ptr(png_ptr);
+    if(stream == NULL) {
+        png_error(png_ptr, "invalid stream");
+        return;
+    }
+
+    if(stream->is_mem) {
+        if(stream->mem_ofs + length > stream->mem_size) {
+            png_error(png_ptr, "png buffer underrun");
+            return;
+        }
+        lv_memcpy(data, stream->mem + stream->mem_ofs, length);
+        stream->mem_ofs += length;
+    }
+    else {
+        uint32_t rn = 0;
+        lv_fs_read(&stream->file, data, (uint32_t)length, &rn);
+        if(rn != length) {
+            png_error(png_ptr, "png file read failed");
+            return;
+        }
+    }
+}
